{
  "name": "poscloud-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Pruebas end-to-end de POS Cloud contra el entorno de testing",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:ui:headed": "playwright test --project=ui --headed",
    "test:circuits": "playwright test --project=circuits",
    "test:circuits:headed": "playwright test --project=circuits --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  }
}
